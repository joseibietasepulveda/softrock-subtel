# Copiar a .env y completar. No subir .env al repositorio.
# Para Compose use una contraseña PostgreSQL alfanumérica o hexadecimal.
POSTGRES_PASSWORD=
# Mínimo 10 caracteres, una mayúscula y un número. Se aplica al crear admin.
ADMIN_PASSWORD=
# Opcional: si se omite, no se crea un usuario regular inicial.
REGULAR_PASSWORD=
# Para ./run.sh contra PostgreSQL local. Use la contraseña definida arriba.
DATABASE_URL=
DATA_DIR=./data
WEB_WORKERS=1
PROCESSING_WORKERS=2
JOB_WORKERS=1
BUCKET_ALLOWED_HOSTS=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
EXPLICIT_RULES_FILE=
